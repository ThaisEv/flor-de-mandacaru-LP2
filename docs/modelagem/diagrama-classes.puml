
@startuml
!theme plain

title Flor de Mandacaru
title Diagrama de Classes

skinparam linetype ortho
skinparam shadowing false
skinparam packageStyle rectangle
skinparam defaultFontName Arial
skinparam classAttributeIconSize 0

skinparam class {
    BorderColor #A65D45
    FontColor #49352D
    BackgroundColor #FFF8F0
    ArrowColor #A65D45
}
skinparam interface {
    BorderColor #64845D
    FontColor #38533A
    BackgroundColor #EDF4E9
}
skinparam package {
    BorderColor #A65D45
    FontColor #49352D
    BackgroundColor #FFFDFC
}

' ==========================================
' 01 - CLIENTES E PERFIL
' ==========================================

package "01 - CLIENTES E PERFIL" #F8EDE5 {

    class Cliente {
        - id: Long
        - nome: String
        - email: String
        - senhaHash: String
        - telefone: String
        --
        + cadastrar(): void
        + atualizarPerfil(): void
        + alterarSenha(): void
        + adicionarEndereco(endereco: Endereco): void
        + removerEndereco(endereco: Endereco): void
    }

    class Endereco {
        - id: Long
        - cep: String
        - logradouro: String
        - numero: String
        - complemento: String
        - bairro: String
        - cidade: String
        - estado: String
        --
        + validar(): boolean
    }

    Cliente "1" *-- "0..*" Endereco : endereços
}

' ==========================================
' 02 - CATÁLOGO E PRODUTOS
' ==========================================

package "02 - CATÁLOGO E PRODUTOS" #F1EBDD {

    abstract class Produto {
        - id: Long
        - codigo: String
        - nome: String
        - descricao: String
        - preco: BigDecimal
        - quantidadeEstoque: int
        - ativo: boolean
        --
        + atualizarPreco(preco: BigDecimal): void
        + atualizarEstoque(quantidade: int): void
        + ativar(): void
        + desativar(): void
        + adicionarImagem(imagem: Imagem): void
        + removerImagem(imagem: Imagem): boolean
        + getImagens(): List<Imagem>
        + getImagensPorFinalidade(finalidade: FinalidadeImagem): List<Imagem>
        + getImagemPrincipal(): Optional<Imagem>
        + getImagemIcone(): Optional<Imagem>
        + getImagemComposicao(): Optional<Imagem>
        + getImagemEditorial(): Optional<Imagem>
        + getImagensGaleria(): List<Imagem>
        + definirImagemPrincipal(imagem: Imagem): void
    }

    class Planta {
        - nomeCientifico: String
        - necessidadeAgua: String
        - luminosidade: String
        - cuidados: String
        - tipoPlanta: String
        - possuiFlor: boolean
        - epocaFloracao: String
        - tipoFolhagem: String
    }

    class Vaso {
        - material: String
        - altura: BigDecimal
        - largura: BigDecimal
    }

    class Buque {
        - estilo: String
        --
        + adicionarComponente(produto: Produto, quantidade: int): void
        + removerComponente(produto: Produto): void
    }

    class Arranjo {
        - estilo: String
        - tamanho: String
        --
        + adicionarComponente(produto: Produto, quantidade: int): void
        + removerComponente(produto: Produto): void
        + adicionarVaso(vaso: Vaso): void
        + removerVaso(): void
    }

    class Papel {
        - id: Long
        - codigo: String
        - nome: String
        - precoAdicional: BigDecimal
        - ativo: boolean
        --
        + adicionarImagem(imagem: Imagem): void
        + removerImagem(imagem: Imagem): boolean
        + getImagens(): List<Imagem>
        + getImagensPorFinalidade(finalidade: FinalidadeImagem): List<Imagem>
        + getImagemPrincipal(): Optional<Imagem>
        + getImagemIcone(): Optional<Imagem>
        + definirImagemPrincipal(imagem: Imagem): void
    }

    class Laco {
        - id: Long
        - codigo: String
        - material: String
        - precoAdicional: BigDecimal
        - ativo: boolean
        --
        + adicionarImagem(imagem: Imagem): void
        + removerImagem(imagem: Imagem): boolean
        + getImagens(): List<Imagem>
        + getImagensPorFinalidade(finalidade: FinalidadeImagem): List<Imagem>
        + getImagemPrincipal(): Optional<Imagem>
        + getImagemIcone(): Optional<Imagem>
        + definirImagemPrincipal(imagem: Imagem): void
    }

    class Cor {
        - id: Long
        - nome: String
        - codigoHexadecimal: String
        - descricao: String
    }

    class TamanhoBuque {
        - id: Long
        - codigo: String
        - quantidadeFlores: int
        --
        + getPosicoes(): List<PosicaoBuque>
    }

    class PosicaoBuque {
        - id: Long
        - ordemSelecao: int
        - linha: int
        - coluna: int
    }

    interface ImagemAssociavel

    class Imagem {
        - id: Long
        - codigo: String
        - nomeArquivo: String
        - caminho: String
        - descricao: String
        - finalidade: FinalidadeImagem
        - principal: boolean
        - ordem: int
        --
        + gerarCodigo(codigoProprietario: String, finalidade: FinalidadeImagem, sequencial: Integer): String
        + getFormato(): String
    }

    enum FinalidadeImagem {
        ICONE (ICO)
        COMPOSICAO (CMP)
        EDITORIAL (EDI)
        GALERIA (GAL)
    }

    interface Componivel {
        + adicionarComponente(produto: Produto, quantidade: int): void
        + removerComponente(produto: Produto): void
        + getComposicao(): List<ItemComposicao>
    }

    Produto <|-- Planta
    Produto <|-- Vaso
    Produto <|-- Buque
    Produto <|-- Arranjo

    ImagemAssociavel <|.. Produto
    ImagemAssociavel <|.. Papel
    ImagemAssociavel <|.. Laco
    Produto "1" *-- "0..*" Imagem : imagens
    Papel "1" *-- "0..*" Imagem : imagens
    Laco "1" *-- "0..*" Imagem : imagens

    Produto "0..*" -- "0..*" Cor : cores
    Papel "0..*" -- "0..*" Cor : cores
    Laco "0..*" -- "0..*" Cor : cores

    TamanhoBuque "1" *-- "1..20" PosicaoBuque : grade configurada

    Componivel <|.. Buque
    Componivel <|.. Arranjo

    Buque "0..*" --> "1" Papel : papel padrão
    Buque "0..*" --> "1" Laco : laço padrão
    Arranjo "0..*" --> "0..1" Vaso : vaso padrão

    note right of Cor
        Cores são independentes de produtos e materiais.
        Toda especialização de Produto herda a associação.
        Papel e Laco mantêm associações próprias.
    end note

    note right of PosicaoBuque
        ordemSelecao indica quando preencher a posição;
        linha e coluna indicam sua localização visual.
        Cada tamanho possui tantas posições quanto
        quantidadeFlores.
    end note
}

' ==========================================
' 03 - COMPOSIÇÃO DOS PRODUTOS
' ==========================================

package "03 - COMPOSIÇÃO DOS PRODUTOS" #EAF0E5 {

    class ItemComposicao {
        - id: Long
        - quantidade: int
        --
        + atualizarQuantidade(quantidade: int): void
    }

    Buque "1" *-- "1..*" ItemComposicao : composição
    Arranjo "1" *-- "1..*" ItemComposicao : composição
    ItemComposicao "0..*" --> "1" Produto : componente
}

' ==========================================
' 04 - PERSONALIZAÇÃO
' ==========================================

package "04 - PERSONALIZAÇÃO" #F9EBD9 {

    class Personalizacao {
        - id: Long
        - valorAdicional: BigDecimal
        --
        + calcularValorAdicional(): BigDecimal
        + validar(): boolean
    }

    class ItemPersonalizacao {
        - id: Long
        - quantidade: int
        - precoUnitario: BigDecimal
    }

    Personalizacao "1" *-- "0..*" ItemPersonalizacao : flores em posições
    ItemPersonalizacao "0..*" --> "1" Planta : flor escolhida
    ItemPersonalizacao "0..*" --> "0..1" PosicaoBuque : posição escolhida
    Personalizacao "0..*" --> "0..1" TamanhoBuque : tamanho escolhido

    Personalizacao "0..*" --> "0..1" Papel : papel escolhido
    Personalizacao "0..*" --> "0..1" Laco : laço escolhido
    Personalizacao "0..*" --> "0..1" Vaso : vaso escolhido

    note right of ItemPersonalizacao
        Para buquê: quantidade=1, tamanho obrigatório e
        uma posição distinta por flor. Para arranjo:
        posição e tamanho ausentes; quantidade pode agrupar
        plantas iguais. O pedido exige layout completo
        para buquê personalizado.
    end note
}

' ==========================================
' 05 - CARRINHO DE COMPRAS
' ==========================================

package "05 - CARRINHO DE COMPRAS" #E7EFF3 {

    class Carrinho {
        - id: Long
        - dataCriacao: LocalDateTime
        --
        + adicionarItem(produto: Produto, quantidade: int): void
        + removerItem(item: ItemCarrinho): void
        + atualizarQuantidade(item: ItemCarrinho, quantidade: int): void
        + calcularTotal(): BigDecimal
        + limpar(): void
    }

    class ItemCarrinho {
        - id: Long
        - quantidade: int
        - precoUnitario: BigDecimal
        --
        + calcularSubtotal(): BigDecimal
        + atualizarQuantidade(quantidade: int): void
    }

    Cliente "1" *-- "0..1" Carrinho : carrinho
    Carrinho "1" *-- "0..*" ItemCarrinho : itens
    ItemCarrinho "0..*" --> "1" Produto : produto
    ItemCarrinho "1" *-- "0..1" Personalizacao : personalização
}

' ==========================================
' 06 - PEDIDOS E PAGAMENTOS
' ==========================================

package "06 - PEDIDOS E PAGAMENTOS" #F3E9EE {

    class Pedido {
        - id: Long
        - dataPedido: LocalDateTime
        - status: StatusPedido
        - valorTotal: BigDecimal
        --
        + finalizar(): void
        + cancelar(): void
        + calcularTotal(): BigDecimal
        + atualizarStatus(status: StatusPedido): void
    }

    class ItemPedido {
        - id: Long
        - produtoCodigoSnapshot: String
        - produtoNomeSnapshot: String
        - quantidade: int
        - precoUnitario: BigDecimal
        - subtotal: BigDecimal
        --
        + calcularSubtotal(): BigDecimal
    }

    class EnderecoPedido {
        - cep: String
        - logradouro: String
        - numero: String
        - complemento: String
        - bairro: String
        - cidade: String
        - estado: String
    }

    class PersonalizacaoPedido {
        - tamanhoCodigoSnapshot: String
        - quantidadeFloresSnapshot: int
        - papelCodigoSnapshot: String
        - papelNomeSnapshot: String
        - papelPrecoSnapshot: BigDecimal
        - lacoCodigoSnapshot: String
        - lacoNomeSnapshot: String
        - lacoPrecoSnapshot: BigDecimal
        - vasoCodigoSnapshot: String
        - vasoNomeSnapshot: String
        - vasoPrecoSnapshot: BigDecimal
        - valorAdicionalSnapshot: BigDecimal
    }

    class FlorPedido {
        - plantaCodigoSnapshot: String
        - plantaNomeSnapshot: String
        - quantidade: int
        - ordemSelecao: Integer
        - linha: Integer
        - coluna: Integer
        - precoUnitarioSnapshot: BigDecimal
    }

    class Pagamento {
        - id: Long
        - valor: BigDecimal
        - metodo: MetodoPagamento
        - status: StatusPagamento
        - dataPagamento: LocalDateTime
        - codigoTransacao: String
        --
        + processar(): void
        + confirmar(): void
        + estornar(): void
    }

    enum StatusPedido {
        AGUARDANDO_PAGAMENTO
        PAGO
        EM_PREPARACAO
        ENVIADO
        ENTREGUE
        CANCELADO
    }

    enum MetodoPagamento {
        PIX
        CARTAO_CREDITO
        CARTAO_DEBITO
        DINHEIRO
    }

    enum StatusPagamento {
        PENDENTE
        APROVADO
        RECUSADO
        ESTORNADO
    }

    Cliente "1" --> "0..*" Pedido : realiza
    Pedido "1" *-- "1" EnderecoPedido : endereço congelado
    EnderecoPedido "0..*" --> "0..1" Endereco : endereço de origem (opcional)
    Pedido "1" *-- "1..*" ItemPedido : itens
    ItemPedido "0..*" --> "0..1" Produto : referência de catálogo
    ItemPedido "1" *-- "0..1" PersonalizacaoPedido : snapshot
    PersonalizacaoPedido "1" *-- "0..*" FlorPedido : flores e posições
    FlorPedido "0..*" --> "0..1" Planta : referência de catálogo
    FlorPedido "0..*" --> "0..1" PosicaoBuque : referência de posição
    PersonalizacaoPedido "0..*" --> "0..1" TamanhoBuque : referência de tamanho
    PersonalizacaoPedido "0..*" --> "0..1" Papel : referência de catálogo
    PersonalizacaoPedido "0..*" --> "0..1" Laco : referência de catálogo
    PersonalizacaoPedido "0..*" --> "0..1" Vaso : referência de catálogo
    Pedido "1" *-- "0..*" Pagamento : pagamentos

    note right of PersonalizacaoPedido
        Os valores copiados são a fonte do histórico;
        referências ao catálogo servem somente para
        consulta quando os registros ainda existem.
        FlorPedido preserva planta, quantidade, posição,
        ordem e preço do instante da compra. A posição é
        obrigatória para buquê e ausente para arranjo.
    end note
}

note right of Imagem
    Cada imagem pertence a exatamente um proprietário:
    Produto, Papel ou Laco.
    codigo da imagem não é o id do banco.
    caminho é relativo e aponta para a pasta;
    formato é derivado da extensão do nomeArquivo.
    No máximo uma imagem principal por proprietário.
    Imagens de mesma finalidade recebem sequencial.
end note

@enduml
